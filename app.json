{
  "expo": {
    "name": "Krishi Saathi",
    "slug": "krishi-saathi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.example.krishisaathi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2f6b3f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "org.example.krishisaathi"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Krishi Saathi uses the microphone so you can ask questions by voice."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Krishi Saathi uses the camera so you can send photos of your crops.",
          "photosPermission": "Krishi Saathi lets you send crop photos from your gallery."
        }
      ],
      "expo-asset"
    ],
    "scheme": "krishisaathi"
  }
}
